    "History" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geçmiş"
          }
        }
      }
    },
    "History can't be read. Live measurements continue." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geçmiş kaydı okunamıyor. Canlı ölçümler devam ediyor."
          }
        }
      }
    },
    "History is kept on this Mac: today and the previous 29 UTC days. App history records at most 20 groups per minute, chosen from the top 10 CPU/memory candidates, and at most 256 distinct groups per day. Group averages cover only the observed time of recorded, fully measured members. Command arguments, environment, PID lists and file paths aren't recorded." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kayıt bu Mac'te tutulur: bugün ve önceki 29 UTC günü. Uygulama kaydı dakika başına en çok 20 grup, CPU/bellek ilk 10 adayından seçilir; gün başına en çok 256 farklı grup tutulur. Grup ortalamaları yalnız kaydedilen, tam ölçülmüş üyelerin gözlem sürelerine aittir. Komut argümanları, ortam bilgisi, PID listesi ve dosya yolları kaydedilmez."
          }
        }
      }
    },
    "History isn't available right now." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geçmiş şu anda kullanılamıyor."
          }
        }
      }
    },
