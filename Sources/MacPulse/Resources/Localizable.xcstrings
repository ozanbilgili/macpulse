      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geçmiş bu Mac'te · 30 gün"
          }
        }
      }
    },
    "History record couldn't be completed. Live measurements continue." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geçmiş kaydı tamamlanamadı. Canlı ölçümler devam ediyor."
          }
