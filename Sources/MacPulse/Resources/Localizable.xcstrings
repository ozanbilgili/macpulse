          "stringUnit" : {
            "state" : "translated",
            "value" : "Dizin ve port metadata'sı 10 saniyede bir yenilenir. Başka kullanıcılar ve korumalı süreçler kapsam dışındadır. Liste salt okunurdur."
          }
        }
      }
    },
